rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function editor() {
      return request.auth != null &&
        request.auth.uid in ['l3RZT3v74EdhxN2zzJieyDE6McR2', 'ROcZ8a9vCMcJxju9Q8YL9HFqQE62'];
    }
    match /events/{eventId} {
      allow read: if true;
      allow create: if editor() &&
        request.resource.data.keys().hasOnly(['title','date','time','subject','group','kind','notes','createdAt']) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 100 &&
        request.resource.data.date is string && request.resource.data.date.size() == 10;
      allow update: if editor() &&
        request.resource.data.keys().hasOnly(['title','date','time','subject','group','kind','notes','createdAt']);
      allow delete: if editor();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}